# Copy this file to .env for local development. Never commit the copied file.
# Production values belong in Vercel → Project Settings → Environment Variables.

# Supabase browser connection (the publishable/anon key is intended for browser use).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Optional canonical origin used during server rendering.
VITE_SITE_URL="http://localhost:8080"

# Optional public Google OAuth client ID. Configure the Google client secret only
# in Supabase Authentication → Providers → Google; never put it in this file.
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Server-only variables (set in Vercel when server features require them):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY=""
# GEMINI_API_KEY=""
